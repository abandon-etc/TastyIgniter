server {
    listen 0.0.0.0:${PORT};
    server_name _;

    root /var/www/html/public;
    index index.php index.html;
    charset utf-8;

    client_max_body_size 32m;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Cloud Run's canonical run.app frontend reserves the exact /healthz path
    # before it reaches the container. Keep the slash variant for a
    # container-level liveness probe; Render's existing /healthz stays intact.
    location = /healthz/ {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = / {
        if ($request_method = HEAD) {
            return 200;
        }

        try_files $uri $uri/ /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico {
        try_files $uri /index.php;
        access_log off;
        log_not_found off;
    }

    location = /robots.txt {
        try_files $uri /index.php;
        access_log off;
        log_not_found off;
    }

    location ^~ /_assets/ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri @tastyigniter_combined_assets;
    }

    location ^~ /admin/_assets/ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri @tastyigniter_combined_assets;
    }

    # TastyIgniter combines theme/admin assets through Laravel when they are not
    # present on disk. The URLs include a deploy timestamp, so a conservative
    # browser cache is safe while avoiding repeated multi-second asset requests.
    location @tastyigniter_combined_assets {
        add_header Cache-Control "public, max-age=86400";

        fastcgi_buffer_size 64k;
        fastcgi_buffers 32 64k;
        fastcgi_busy_buffers_size 512k;
        fastcgi_temp_file_write_size 512k;

        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_hide_header X-Powered-By;
        fastcgi_hide_header Cache-Control;
        fastcgi_hide_header Expires;
    }

    # Livewire serves its frontend assets and file endpoints through Laravel
    # routes. Keep these paths out of the static extension matcher below.
    location ^~ /livewire/ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~* \.(?:css|js|jpg|jpeg|gif|png|webp|svg|ico|woff|woff2|ttf|eot)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location ^~ /storage/ {
        autoindex off;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location ^~ /media/ {
        autoindex off;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location ^~ /themes/ {
        autoindex off;
        try_files $uri =404;
    }

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~* \.(?:env|ini|log|sql|sqlite|bak|backup|old|orig|save|swp|dist)$ {
        deny all;
    }
}
